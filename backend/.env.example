# App
APP_ENV=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Toggle: yes -> use CLOUD_DATABASE_URL (Neon/Supabase). no -> local SQLite file.
USE_CLOUD_DB=no
# Neon/Supabase connection string. sslmode/channel_binding params are stripped
# automatically; the postgres:// scheme is upgraded to postgresql+asyncpg://.
CLOUD_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
LOCAL_DATABASE_URL=sqlite+aiosqlite:///./gym_platform.db

# Redis (Celery broker + rate limiting + idempotency cache)
REDIS_URL=XXXXX

# Stripe (platform SaaS billing + Connect). Keep secret keys on the backend only.
# Local platform + Connect webhook forwarding (CLI prints a signing secret for each endpoint):
# stripe listen --events=checkout.session.completed,customer.subscription.updated,invoice.payment_succeeded,invoice.payment_failed,customer.subscription.deleted,account.updated,payment_intent.succeeded,payment_intent.payment_failed,setup_intent.succeeded,charge.refunded --forward-to localhost:8000/api/v1/webhooks/stripe --forward-connect-to localhost:8000/api/v1/webhooks/stripe-connect
# Put the platform endpoint's whsec_ value in STRIPE_WEBHOOK_SECRET and the Connect endpoint's in STRIPE_CONNECT_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx
FRONTEND_URL=http://localhost:3000

# Inbox channel credentials are added per workspace in Settings → Inbox channels.
# Generate a Fernet key once and keep it stable; losing it makes saved provider
# credentials unreadable: backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INBOX_ENCRYPTION_KEY=
# Public HTTPS origin for provider webhooks; expose the API through a trusted
# domain/tunnel for local development. Routes use /api/v1/inbox/webhooks/...
INBOX_PUBLIC_WEBHOOK_BASE_URL=https://api.example.com
INBOX_META_GRAPH_VERSION=v25.0

# Email / Push. Configure either Resend or SMTP. SMTP settings used by inbox
# replies are these individual variables (SMTP_URL is not used by the sender).
RESEND_API_KEY=
EMAIL_FROM=no-reply@your-verified-domain.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Assistant (Groq, OpenAI-compatible). Leave blank to run the deterministic
# offline stub — the assistant streams a canned reply with no vendor calls.
GROQ_API_KEY=
ASSISTANT_MODEL=openai/gpt-oss-120b

# Security
HIBP_API_URL=https://api.pwnedpasswords.com

